{
  "name": "agent-phone-harness",
  "version": "0.1.0",
  "description": "Give an AI agent its own phone. Uniform perception/action harness over Android, iOS and mock devices, exposed via MCP, HTTP and CLI.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "phone": "dist/cli.js",
    "phone-mcp": "dist/mcp/stdio.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "config", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "serve": "tsx src/http/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.5.0",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
