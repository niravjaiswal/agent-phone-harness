# Copied to deploy/.env by install.sh. Everything is optional.

# Which tunnel to run: "quick" (default, no account), "named" (stable hostname),
# or empty if you put your own reverse proxy in front of 127.0.0.1:8712.
COMPOSE_PROFILES=quick

# Named tunnel only.
# CLOUDFLARE_TUNNEL_TOKEN=
# PHONE_PUBLIC_URL=https://phone.example.com

# Android version and screen. redroid publishes 11.0.0 through 15.0.0.
# REDROID_TAG=14.0.0-latest
# PHONE_WIDTH=1080
# PHONE_HEIGHT=2340
# PHONE_DPI=420

# Tokens are generated on first start and kept in the harness volume; show them
# with `docker compose exec harness agent-phone token`. Pin them here only if
# you manage secrets elsewhere. They must differ.
# PHONE_AGENT_TOKEN=
# PHONE_OPERATOR_TOKEN=

# Everything else (number, notifications, secrets, policy) is set in the panel.
